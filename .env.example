# ==============================================================================
# Echoes Search - Environment Variables Template
# Copy this file to .env and fill in your actual credentials.
# NEVER commit your actual .env file to version control!
# ==============================================================================

# Application Settings
APP_NAME="Echoes Search"
APP_VERSION="0.1.0"
DEBUG=True

# MongoDB Atlas Database
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=
MONGODB_DATABASE=echoes_db

# Google Gemini API
GEMINI_API_KEY=
MODEL_NAME=gemini-2.5-flash

# Storage & Supabase Cloud Storage
UPLOAD_DIR=./storage/documents
CHROMA_PATH=./storage/vectors
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_KEY=<your-supabase-service-role-secret-key>
SUPABASE_BUCKET=Echoes_documents
SUPABASE_PUBLIC_URL_EXPIRY=3600

# Document Processing & Embeddings
CHUNK_SIZE=512
CHUNK_OVERLAP=64
MAX_FILE_SIZE_MB=50
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_BATCH_SIZE=32

# Hybrid Retrieval Settings
TOP_K_SEMANTIC=20
TOP_K_BM25=20
TOP_K_RERANKED=10

# Authentication & Security
# Generate a strong 32+ byte secret: openssl rand -hex 32
JWT_SECRET_KEY=your-super-secret-jwt-token-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
GOOGLE_CLIENT_ID=

# Allowed CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
